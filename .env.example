# Copy to .env and configure your dedicated local databases.
# All connection values below are placeholders. Never use production databases for tests.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Optional direct connection for Prisma CLI migrations; same database as above.
# Runtime always uses DATABASE_URL. Leave blank for local PostgreSQL.
DIRECT_URL=""

# Prisma development migrations only; must be a separate empty/disposable database.
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/SHADOW_DATABASE?schema=public"

# Stable NextAuth v4 names; do not mix with v5 beta setup examples.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REPLACE_WITH_A_SECURE_RANDOM_SECRET"

# Optional until you enable Google sign-in. See docs/AUTHENTICATION.md.
GOOGLE_CLIENT_ID="REPLACE_WITH_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="REPLACE_WITH_GOOGLE_CLIENT_SECRET"

# Server-only AI configuration. Feedback and report summaries use NVIDIA_MODEL.
NVIDIA_API_KEY="REPLACE_WITH_NVIDIA_API_KEY"
NVIDIA_MODEL="google/gemma-4-31b-it"
# Business chat has its own approved model; blank values use this default.
NVIDIA_ASSISTANT_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"

# Separate disposable database for integration tests; never point at production.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/TEST_DATABASE?schema=public"
